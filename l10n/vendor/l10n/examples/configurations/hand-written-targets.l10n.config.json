{
  "locales": { "source": "it", "targets": ["en"] },
  "memory": { "dir": "i18n" },
  "glossary": "i18n/glossary.json",
  "promptsDir": "i18n/prompts",
  "adapter": {
    "kind": "json-content",
    "content": {
      "source": "src/data_build/content/{lang}",
      "target": "src/data_build/content/{lang}",
      "staging": "i18n/generated/content/{lang}",
      "usageLabel": "content/{lang}"
    },
    "ui": {
      "source": "src/data_build/ui-dictionary/{lang}.json",
      "target": "src/data_build/ui-dictionary/{lang}.json",
      "staging": "i18n/generated/ui-dictionary/{lang}.json"
    },
    "langMap": "src/data_build/lang-map.json",
    "fields": {
      "denylistKeys": ["image", "url", "href", "src", "to", "path", "slug", "pdf", "file", "background", "backgroundImage", "hoverImage", "imageHref", "headingHref", "id", "anchor", "target", "headingTarget", "rel", "variant", "layout", "headingSize", "rule", "color", "swatch", "swatchColumns", "noGap", "showMore", "icon", "ogImage", "ogType", "ogTitle", "ogDescription", "twitterCard", "type", "kind", "code", "famiglia", "style", "tone", "subheadingStyle", "displayTone", "displayWeight", "textTone", "dividerTone", "aspect", "align", "entranceDirection", "introWidth", "imageMaxW", "revealEffect", "linea_commerciale", "formKey", "fieldKey", "submitValue"],
      "pageFields": { "seo": ["title", "description"] },
      "valueGuards": {
        "refPrefixes": ["/", "http://", "https://", "#"],
        "assetExtensions": ["jpg", "jpeg", "png", "svg", "webp", "gif", "pdf", "mp4", "webm"],
        "excludeNumbers": true,
        "excludeBooleans": true
      }
    },
    "output": {
      "pairs": "langMap",
      "fileName": "path",
      "langField": false,
      "keyOrder": "source",
      "materialize": "safe"
    }
  },
  "backend": { "kind": "anthropic", "model": "claude-opus-5-5", "apiKeyEnv": "ANTHROPIC_API_KEY" }
}
