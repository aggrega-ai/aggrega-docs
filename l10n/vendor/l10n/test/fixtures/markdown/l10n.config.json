{
  "locales": { "source": "en", "targets": ["it", "de"] },
  "memory": { "dir": "memory" },
  "adapter": {
    "kind": "markdown",
    "sourceDir": "docs",
    "include": ["**/*.md"],
    "exclude": ["drafts/**"],
    "outDir": "out",
    "policies": {
      "paths": [{ "glob": "reference/generated-*.md", "policy": "keep" }],
      "regions": { "kept-options": "keep" }
    }
  }
}
