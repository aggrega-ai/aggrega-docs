{
  "locales": "locales.json",
  "memory": { "dir": "memory" },
  "glossary": "glossary.json",
  "adapter": {
    "kind": "json-content",
    "content": {
      "source": "content/{lang}",
      "target": "content/{lang}",
      "staging": "memory/generated/content/{lang}"
    },
    "ui": {
      "source": "ui/{lang}.json",
      "target": "ui/{lang}.json",
      "staging": "memory/generated/ui/{lang}.json"
    },
    "langMap": "lang-map.json",
    "fields": {
      "denylistKeys": ["image", "to", "variant"],
      "pageFields": { "seo": ["title", "description"] },
      "valueGuards": {
        "refPrefixes": ["/", "https://", "#"],
        "assetExtensions": ["jpg", "png"],
        "excludeNumbers": true,
        "excludeBooleans": true
      }
    }
  },
  "backend": { "kind": "anthropic" }
}
