{
  "storageKey": "aggrega-a11y",
  "features": [
    "textSize",
    "lineHeight",
    "letterSpacing",
    "font",
    "align",
    "color",
    "highlightLinks",
    "highlightHeadings",
    "textMagnifier",
    "readAloud",
    "readingMode",
    "pageStructure",
    "stopAnimations",
    "hideImages",
    "readingGuide",
    "readingMask",
    "cursor",
    "highlightFocus",
    "highlightHover",
    "tooltips"
  ],
  "textSizes": [100, 110, 120, 135, 150],
  "lineHeights": [0, 1.7, 2, 2.3],
  "letterSpacings": [0, 0.06, 0.12],
  "profiles": {
    "vision": { "textSize": 2, "color": "high", "highlightLinks": true, "highlightHeadings": true, "cursor": "black" },
    "reading": { "font": "dyslexic", "lineHeight": 1, "letterSpacing": 1, "readingGuide": true },
    "seizure": { "stopAnimations": true, "color": "lowSaturation" },
    "focus": { "stopAnimations": true, "readingMask": true, "highlightFocus": true }
  },
  "position": { "side": "right", "bottom": "16px" },
  "shortcut": "",
  "feedbackEmail": ""
}
