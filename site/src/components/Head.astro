---
import { resolveVersioning } from "../versioning.mjs";
import faviconIco from "@aggrega-ai/brand/logo/favicon.ico?url";
import favicon192 from "@aggrega-ai/brand/logo/favicon-192.png?url";
import appleTouchIcon from "@aggrega-ai/brand/logo/favicon-180.png?url";

// The default document head already emits a self-referential canonical link and
// an og:url for the current page. For any version other than the latest, those
// point the reader (and search engines) at the same page under the unversioned
// latest path instead, and the page asks crawlers not to index the versioned
// copy. The latest version is served at the unversioned path and keeps the head
// the site emits by default.
const { isLatest, base, latestBase, site } = resolveVersioning();

// The default head carries a favicon link pointing at an unversioned path that
// the site does not ship. Drop it here so the only tab icon is the brand one
// pushed below, single-sourced from the brand package.
const head = Astro.locals.starlightRoute.head
  .filter(
    (entry) => !(entry.tag === "link" && entry.attrs?.rel === "shortcut icon"),
  )
  .map((entry) => {
  if (isLatest) return entry;
  if (
    entry.tag === "link" &&
    entry.attrs?.rel === "canonical" &&
    typeof entry.attrs.href === "string"
  ) {
    return {
      ...entry,
      attrs: { ...entry.attrs, href: entry.attrs.href.replace(base, latestBase) },
    };
  }
  if (
    entry.tag === "meta" &&
    entry.attrs?.property === "og:url" &&
    typeof entry.attrs.content === "string"
  ) {
    return {
      ...entry,
      attrs: {
        ...entry.attrs,
        content: entry.attrs.content.replace(base, latestBase),
      },
    };
  }
  return entry;
});

if (!isLatest) {
  head.push({ tag: "meta", attrs: { name: "robots", content: "noindex,follow" } });
}

// The canonical URL the head resolves to is the single source for the page's
// address: self-referential on the latest version, rewritten to the latest
// path on any older version (above). Structured data and the sharing card reuse
// that value rather than recomputing it, so a page never advertises two
// different addresses.
const canonicalHref = head.find(
  (entry) =>
    entry.tag === "link" &&
    entry.attrs?.rel === "canonical" &&
    typeof entry.attrs.href === "string",
)?.attrs?.href as string | undefined;

const { entry } = Astro.locals.starlightRoute;
const id = entry.id;
const pageTitle = entry.data.title ?? "Aggrega";
const description =
  typeof entry.data.description === "string" && entry.data.description
    ? entry.data.description
    : "Aggrega documentation";

// The per-page sharing image is generated at /og/<page-id>.png (see
// src/pages/og). Older versions share the latest version's card, matching the
// canonical rewrite above.
const imageBase = isLatest ? base : latestBase;
const ogImage = `${site}${imageBase}/og/${id}.png`;

head.push({
  tag: "meta",
  attrs: { property: "og:image", content: ogImage },
});
head.push({
  tag: "meta",
  attrs: { property: "og:image:width", content: "1200" },
});
head.push({
  tag: "meta",
  attrs: { property: "og:image:height", content: "630" },
});
head.push({
  tag: "meta",
  attrs: { name: "twitter:image", content: ogImage },
});
// Single-source the tab icons from the brand package (the logo above is already
// single-sourced the same way); Vite emits each as a hashed asset, or inlines one
// below its inline-size threshold as a data URI.
head.push({
  tag: "link",
  attrs: { rel: "icon", sizes: "16x16 32x32 48x48", href: faviconIco },
});
head.push({
  tag: "link",
  attrs: { rel: "icon", type: "image/png", sizes: "192x192", href: favicon192 },
});
head.push({
  tag: "link",
  attrs: { rel: "apple-touch-icon", sizes: "180x180", href: appleTouchIcon },
});

// Structured data: a site-level WebSite record, a documentation-article record
// for the page (an API-reference record for the CLI and schema reference
// pages), and a breadcrumb trail derived from the page's route. The article and
// breadcrumb addresses reuse the resolved canonical URL.
function humanize(segment: string): string {
  return segment
    .replace(/^\d+-/, "")
    .split("-")
    .map((word) => (word ? word[0].toUpperCase() + word.slice(1) : word))
    .join(" ");
}

const websiteId = `${site}${latestBase}#website`;
const isApiReference =
  id === "language-reference/cli" ||
  id.startsWith("language-reference/cli/") ||
  id === "language-reference/schema" ||
  id.startsWith("language-reference/schema/");

const pageBase = isLatest ? base : latestBase;
const segments = id === "index" ? [] : id.split("/");
const crumbs = [{ name: "Documentation", url: `${site}${pageBase}/` }];
let accumulated = "";
segments.forEach((segment, index) => {
  accumulated += (accumulated ? "/" : "") + segment;
  const isLast = index === segments.length - 1;
  crumbs.push({
    name: isLast ? pageTitle : humanize(segment),
    url:
      isLast && canonicalHref
        ? canonicalHref
        : `${site}${pageBase}/${accumulated}/`,
  });
});

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Aggrega",
      url: `${site}${latestBase}`,
    },
    {
      "@type": isApiReference ? "APIReference" : "TechArticle",
      "@id": canonicalHref ? `${canonicalHref}#article` : undefined,
      headline: pageTitle,
      name: pageTitle,
      description,
      url: canonicalHref,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    },
  ],
};
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
