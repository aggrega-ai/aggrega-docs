---
import Default from "@astrojs/starlight/components/Banner.astro";

// The root locale (English) is the authored source of every page and is served
// unprefixed. Every other locale is produced by the offline translation
// pipeline, so its pages carry a notice inviting readers to correct the
// machine translation. Root-locale route data reports an undefined locale;
// any defined locale is a translated page. The default Starlight banner (the
// per-page frontmatter banner, if any) still renders unchanged above the
// notice.
const { locale } = Astro.locals.starlightRoute;
const machineTranslated = Boolean(locale);
---

<Default />
{
  machineTranslated && (
    <div class="machine-translation-notice" data-pagefind-ignore>
      This page was machine-translated. Contribute a correction.
    </div>
  )
}

<style>
  .machine-translation-notice {
    padding: 0.5rem 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--sl-color-orange);
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    font-size: var(--sl-text-body-sm);
    line-height: var(--sl-line-height-headings);
    border-radius: 0.25rem;
  }
</style>
