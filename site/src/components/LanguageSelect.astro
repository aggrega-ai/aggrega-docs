---
import { Icon } from "@astrojs/starlight/components";
import context from "virtual:starlight/project-context";
import config from "virtual:starlight/user-config";
// Starlight exports this helper from no package entry point, so it is imported
// by path, as src/components/Banner.astro imports its helpers.
import { localizedUrl } from "../../node_modules/@astrojs/starlight/utils/localizedUrl.ts";

// The language picker, in the header and in the narrow screen's menu, in place
// of Starlight's: a drop-down whose closed control shows the current language
// and whose menu lists every published language, the current one checked. Each
// entry is a link to the page the reader is on in that language, as Starlight's
// own picker computes it, named in its own language and marked with its own
// `lang`.
//
// The page is built with a `<details>` element, so the menu opens and its links
// work without client JavaScript. The script replaces the element's control
// with a button opening a menu, operated as one: Enter, Space or a click opens
// it on the current language, ArrowDown on the first and ArrowUp on the last;
// in the menu the arrow keys, Home and End move between the entries, a letter
// moves to the next language whose name starts with it, Enter or Space follows
// the link, and Escape closes it and returns the focus to the button. A click
// outside it, or the focus leaving it, closes it too.
//
// Every language other than the page's also carries its name in the page's
// language (on an English page, 日本語 is "Japanese"), shown beside it while the
// entry is under the pointer or has the focus and given to assistive technology
// as the entry's description. The browser supplies the name, through its own
// Intl.DisplayNames, after the page has loaded, so nothing is translated by hand
// and a browser that cannot name a language shows nothing extra. The entries
// are links rather than the options of a native drop-down, because those take
// neither the focus nor a description on every platform.
const route = Astro.locals.starlightRoute;
const currentCode = route.locale ?? "root";
const locales = Object.entries(config.locales ?? {});
const current = config.locales?.[currentCode];
const options = locales.map(([code, locale]) => ({
  href: localizedUrl(Astro.url, code, context.trailingSlash).pathname,
  label: locale!.label,
  lang: locale!.lang ?? code,
  current: code === currentCode,
}));
---

{
  config.isMultilingual && current && (
    <aggrega-lang-select data-page-lang={current.lang}>
      <details>
        <summary class="control">
          <span class="sr-only">{Astro.locals.t("languageSelect.accessibleLabel")}: </span>
          <Icon name="translate" class="label-icon" />
          <span lang={current.lang}>{current.label}</span>
          <Icon name="down-caret" class="caret" />
        </summary>
        <ul>
          {options.map(({ href, label, lang, current: isCurrent }) => (
            <li>
              <a href={href} hreflang={lang} lang={lang} aria-current={isCurrent ? "page" : undefined}>
                <Icon name="approve-check" class="check" />
                <span data-label>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </aggrega-lang-select>
  )
}

<script>
  function languageNameIn(code: string, inLang: string): string | undefined {
    if (typeof Intl === "undefined" || typeof Intl.DisplayNames !== "function") return undefined;
    try {
      if (Intl.DisplayNames.supportedLocalesOf([inLang]).length === 0) return undefined;
      const name = new Intl.DisplayNames([inLang], { type: "language", fallback: "none" }).of(code);
      return name === undefined || name === "" ? undefined : name;
    } catch {
      return undefined;
    }
  }

  let count = 0;

  class AggregaLanguageSelect extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector("details");
      const summary = details?.querySelector("summary");
      const menu = details?.querySelector("ul");
      const entries = [...this.querySelectorAll<HTMLAnchorElement>("a[lang]")];
      if (!details || !summary || !menu || entries.length === 0) return;
      const pageLang = this.dataset.pageLang ?? "";
      const instance = ++count;
      const labels = entries.map((link) => link.querySelector("[data-label]")?.textContent?.trim() ?? "");
      const current = entries.find((link) => link.getAttribute("aria-current") === "page") ?? entries[0];

      entries.forEach((link, index) => {
        if (link === current) return;
        const name = languageNameIn(link.lang, pageLang);
        if (name === undefined || name === labels[index]) return;
        const hint = document.createElement("span");
        hint.id = `language-name-${instance}-${link.lang}`;
        hint.lang = pageLang;
        hint.setAttribute("aria-hidden", "true");
        hint.dataset.languageName = "";
        hint.textContent = name;
        link.append(hint);
        link.setAttribute("aria-describedby", hint.id);
      });

      // The button takes the summary's attributes, the stylesheet's scoping
      // among them, and its content.
      const button = document.createElement("button");
      button.type = "button";
      for (const { name, value } of summary.attributes) button.setAttribute(name, value);
      button.append(...summary.childNodes);
      button.id = `language-select-${instance}`;
      menu.id = `language-menu-${instance}`;
      button.setAttribute("aria-haspopup", "menu");
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-controls", menu.id);
      menu.setAttribute("role", "menu");
      menu.setAttribute("aria-labelledby", button.id);
      menu.tabIndex = -1;
      menu.hidden = true;
      for (const item of menu.children) item.setAttribute("role", "none");
      for (const link of entries) {
        link.setAttribute("role", "menuitem");
        link.tabIndex = -1;
      }
      details.replaceWith(button, menu);

      const isOpen = () => button.getAttribute("aria-expanded") === "true";
      const open = (entry: HTMLAnchorElement) => {
        button.setAttribute("aria-expanded", "true");
        menu.hidden = false;
        entry.focus();
      };
      const close = (returnFocus: boolean) => {
        if (!isOpen()) return;
        button.setAttribute("aria-expanded", "false");
        menu.hidden = true;
        if (returnFocus) button.focus();
      };

      button.addEventListener("click", () => (isOpen() ? close(false) : open(current)));
      button.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
        event.preventDefault();
        open(event.key === "ArrowDown" ? entries[0] : entries[entries.length - 1]);
      });
      menu.addEventListener("keydown", (event) => {
        const at = entries.indexOf(document.activeElement as HTMLAnchorElement);
        const last = entries.length - 1;
        let next: HTMLAnchorElement | undefined;
        if (event.key === "ArrowDown") next = entries[at < 0 || at === last ? 0 : at + 1];
        else if (event.key === "ArrowUp") next = entries[at <= 0 ? last : at - 1];
        else if (event.key === "Home") next = entries[0];
        else if (event.key === "End") next = entries[last];
        else if (event.key === " " && at >= 0) {
          event.preventDefault();
          entries[at].click();
          return;
        } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
          const letter = event.key.toLocaleLowerCase();
          for (let step = 1; step <= entries.length; step++) {
            const index = (at + step + entries.length) % entries.length;
            if (labels[index].toLocaleLowerCase().startsWith(letter)) {
              next = entries[index];
              break;
            }
          }
        }
        if (next === undefined) return;
        event.preventDefault();
        next.focus();
      });
      // The entry under the pointer takes the focus, so the highlighted entry is
      // always the focused one and the arrow keys move on from it.
      menu.addEventListener("pointermove", (event) => {
        const entry = (event.target as Element).closest<HTMLAnchorElement>("a[lang]");
        if (entry && document.activeElement !== entry) entry.focus({ preventScroll: true });
      });
      menu.addEventListener("pointerleave", () => {
        if (isOpen() && menu.contains(document.activeElement)) menu.focus({ preventScroll: true });
      });
      // Starlight's narrow-screen menu closes itself on the Escape key's release,
      // so the release of an Escape that closed this menu stops here: it closes
      // this menu alone, and a second Escape closes the narrow-screen menu.
      let closedOnEscape = false;
      this.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !isOpen()) return;
        event.preventDefault();
        closedOnEscape = true;
        close(true);
      });
      this.addEventListener("keyup", (event) => {
        if (event.key !== "Escape" || !closedOnEscape) return;
        closedOnEscape = false;
        event.stopPropagation();
      });
      document.addEventListener("click", (event) => {
        if (!this.contains(event.target as Node)) close(false);
      });
      this.addEventListener("focusout", (event) => {
        if (!this.contains(event.relatedTarget as Node | null)) close(false);
      });
      // A page restored from the back-forward cache shows the menu closed.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) close(false);
      });
    }
  }
  customElements.define("aggrega-lang-select", AggregaLanguageSelect);
</script>

<style>
  aggrega-lang-select {
    position: relative;
    display: block;
  }
  .control {
    --sl-label-icon-size: 0.875rem;
    --sl-caret-size: 1.25rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding-block: 0.625rem;
    padding-inline: calc(var(--sl-label-icon-size) + 0.5rem) calc(var(--sl-caret-size) + 0.25rem);
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .control::-webkit-details-marker {
    display: none;
  }
  .control:hover,
  details[open] > .control,
  .control[aria-expanded="true"] {
    color: var(--sl-color-white);
  }
  .control .label-icon,
  .control .caret {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .control .label-icon {
    font-size: var(--sl-label-icon-size);
    inset-inline-start: 0;
  }
  .control .caret {
    font-size: var(--sl-caret-size);
    inset-inline-end: 0;
    transition: transform 0.15s ease;
  }
  details[open] > .control .caret,
  .control[aria-expanded="true"] .caret {
    transform: translateY(-50%) rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .control .caret {
      transition: none;
    }
  }
  @media (min-width: 50rem) {
    .control {
      font-size: var(--sl-text-sm);
    }
  }
  ul {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.25rem);
    inset-inline-end: 0;
    min-width: 13rem;
    max-height: 70vh;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background-color: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  ul[hidden] {
    display: none;
  }
  ul:focus {
    outline: none;
  }
  /* In the narrow screen's menu the picker sits at the menu's end, so its menu opens upwards. */
  :global(#starlight__sidebar) ul {
    top: auto;
    bottom: calc(100% + 0.25rem);
  }
  li {
    margin: 0;
  }
  a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  a .check {
    flex: none;
    font-size: 1rem;
    opacity: 0;
  }
  a[aria-current="page"] .check {
    opacity: 1;
  }
  a[aria-current="page"] {
    font-weight: 600;
  }
  /* In the menu the highlighted entry is the focused one, which the pointer
     moves; in the page as built, the entry under the pointer or the keyboard's
     focus. */
  a:not([role]):hover,
  a:not([role]):focus-visible,
  a[role="menuitem"]:focus {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  a :global([data-language-name]) {
    visibility: hidden;
    margin-inline-start: auto;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.25rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }
  a:not([role]):hover :global([data-language-name]),
  a:not([role]):focus-visible :global([data-language-name]),
  a[role="menuitem"]:focus :global([data-language-name]) {
    visibility: visible;
  }
</style>
