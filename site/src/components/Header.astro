---
import config from "virtual:starlight/user-config";
import { Icon } from "@astrojs/starlight/components";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import siteNav from "virtual:aggrega-docs/site-nav";
import { GITHUB_HREF, catalogHref, docsHref } from "../site-nav.mjs";

// The header, in place of Starlight's: the brand leading to the Aggrega home
// page, this site's search, then the Aggrega menu the home site and the catalog
// show in the same order and look (src/site-nav.mjs): the documentation, the
// catalog, the examples and the GitHub repository, the theme switch and the
// language picker. On a narrow screen the menu's links are left out of the bar. On
// a page with the sidebar the theme switch is left out too, being in Starlight's
// menu (see src/components/MobileMenuFooter.astro); on a page without the
// sidebar, which has no menu button, the theme switch stays in the bar before
// the language picker. The search button and the language picker sit together
// at the bar's end, beside Starlight's menu button.
// From 50rem the first grid column keeps the search aligned with the content
// column when the bar has room and gives way to the controls when it has not,
// so the picker keeps its full name.
// The labels are the page's language's translation of src/strings/site-nav.md
// (siteNavLabels in src/translations.mjs), each marked with the language it is
// in, so a label the translation memory lacks is marked as English.
const route = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
const labels = siteNav[route.locale ?? ""] ?? siteNav[""];
const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
const newTabId = "site-nav-new-tab";
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="search-wrapper sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="end-group sl-flex print:hidden">
    <div class="right-group">
      <nav aria-label="Aggrega" class="site-nav">
        <a href={route.siteTitleHref} lang={labels.docs.lang}>{labels.docs.text}</a>
        <a href={catalogHref(route.locale)} lang={labels.catalog.lang}>{labels.catalog.text}</a>
        <a href={docsHref(base, route.locale, "language-reference/examples/")} lang={labels.examples.lang}>
          {labels.examples.text}
        </a>
        <a
          href={GITHUB_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link"
          lang={labels.githubStar.lang}
          aria-label={labels.githubStar.text}
          aria-describedby={newTabId}
          title={labels.githubStar.text}
        >
          <Icon name="github" size="1.25rem" />
          <Icon name="star" size="1rem" />
        </a>
        <span id={newTabId} lang={labels.newTab.lang} hidden>{labels.newTab.text}</span>
      </nav>
      <ThemeSelect />
    </div>
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .end-group,
  .right-group {
    gap: 0.5rem;
    align-items: center;
  }

  .right-group {
    display: flex;
  }

  @media (max-width: 49.99rem) {
    .header {
      gap: 0.5rem;
    }
    .title-wrapper {
      flex: none;
    }
    .search-wrapper {
      margin-inline-start: auto;
    }
    .end-group {
      flex: 0 1 auto;
      min-width: 0;
    }
    .right-group .site-nav {
      display: none;
    }
    .right-group {
      display: none;
    }
    :global(:root:not([data-has-sidebar])) .right-group {
      display: flex;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-inline-end: 1rem;
  }

  .site-nav a {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--sl-color-text-accent);
  }

  .site-nav .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }

  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(min-content, calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))))
        1fr
        auto;
      align-content: center;
    }
  }
</style>
