---
import Default from "@astrojs/starlight/components/Footer.astro";
import siteNav from "virtual:aggrega-docs/site-nav";
import { languageAttributes, sourceLanguage } from "../translations.mjs";

// Starlight's own footer, then a link to the privacy page the home site serves
// at the domain's root. The home site publishes the documentation's languages
// under the same path segments (/privacy/ in English, /ja/privacy/ in
// Japanese), so a page links to the privacy page in the page's language. The
// link's label is the page's language's translation of src/strings/site-nav.md
// (siteNavLabels in src/translations.mjs), marked with the language it is in when that is not the source language. The
// link is left out of the search index, which holds each page's own text.
const { locale } = Astro.locals.starlightRoute;
const label = (siteNav[locale ?? ""] ?? siteNav[""]).privacy;
const privacyHref = locale ? `/${locale}/privacy/` : "/privacy/";
---

<Default />
<p class="privacy-link" data-pagefind-ignore><a href={privacyHref} {...(label.lang === sourceLanguage.lang ? {} : languageAttributes(label.lang))}>{label.text}</a></p>

<style>
  .privacy-link {
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .privacy-link a {
    color: inherit;
  }
  .privacy-link a:hover {
    color: var(--sl-color-white);
  }
</style>
