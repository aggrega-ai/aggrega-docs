---
import Select from "@astrojs/starlight/components/Select.astro";
import siteNav from "virtual:aggrega-docs/site-nav";
import { resolveVersioning, VERSIONS_PATH } from "../versioning.mjs";

// The version selector: a drop-down in the shape of the language picker. The
// page renders its own version as the selected option, so it shows the right
// version without script. In the browser the script fills in the other
// published versions from the one list served at /docs/versions.json, on the
// same origin, so no version's pages carry the list. Choosing a version opens
// the same page, in the same language, in that version; a page that version
// lacks lands on its not-found page.
//
// The selector's screen-reader name is the page's language's translation of
// src/strings/site-nav.md (siteNavLabels in src/translations.mjs).
//
// The select spans the whole width of the control. The drop-down symbol is
// drawn at the control's far end and lets presses through to what lies under
// it, so a narrower select would leave the symbol over the bare label, where a
// press only focuses the select without opening its list.
const { version, base } = resolveVersioning();
const { locale } = Astro.locals.starlightRoute;
const name = (siteNav[locale ?? ""] ?? siteNav[""]).documentationVersion.text;
---

<docs-version-select data-version={version} data-base={base} data-list={VERSIONS_PATH}>
  <Select
    icon="code-branch"
    label={name}
    options={[{ label: version, value: base, selected: true }]}
    width="100%"
  />
</docs-version-select>

<style>
  docs-version-select {
    display: block;
    padding: 0.25rem 0 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    margin-bottom: 0.5rem;
  }
</style>

<script>
  // The list's shape: { "versions": [{ "label": "v0.8", "base": "/docs/v0.8" },
  // { "label": "v0.9", "base": "/docs", "latest": true }, …] }, the newest first.
  type Version = { label: string; base: string; latest?: boolean };

  class DocsVersionSelect extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector("select");
      if (!select) return;
      const { version, base, list } = this.dataset;
      if (!version || base === undefined || !list) return;

      select.addEventListener("change", () => {
        const here = window.location.pathname;
        const page = here.startsWith(base) ? here.slice(base.length) : "/";
        window.location.assign(select.value + (page || "/") + window.location.hash);
      });
      window.addEventListener("pageshow", (event) => {
        if (!event.persisted) return;
        const markup = select.querySelector<HTMLOptionElement>("option[selected]")?.index ?? 0;
        if (select.selectedIndex !== markup) select.selectedIndex = markup;
      });

      fetch(list, { credentials: "same-origin" })
        .then((response) => (response.ok ? response.json() : undefined))
        .then((data) => {
          const versions: Version[] = Array.isArray(data?.versions) ? data.versions : [];
          if (!versions.some((entry) => entry.label === version)) return;
          select.replaceChildren(
            ...versions.map((entry) => {
              const current = entry.label === version;
              const option = new Option(entry.label, current ? base : entry.base, current, current);
              return option;
            }),
          );
        })
        .catch(() => {});
    }
  }
  customElements.define("docs-version-select", DocsVersionSelect);
</script>
