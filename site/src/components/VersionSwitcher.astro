---
import versionData from "../versions.json";
import { resolveVersioning } from "../versioning.mjs";

// The version list is read from a generated data file so it can be regenerated
// per deploy from the set of published versions. Each entry links to the base
// path of that version; the latest version links to the unversioned /docs path.
const { version } = resolveVersioning();
const versions = Array.isArray(versionData.versions) ? versionData.versions : [];

function isCurrent(entry) {
  if (entry.latest) return version === "latest" || version === entry.label;
  return version === entry.label;
}
---

{
  versions.length > 0 && (
    <nav class="version-switcher" aria-label="Documentation version">
      <span class="version-switcher__label">Version</span>
      <ul class="version-switcher__list">
        {versions.map((entry) => (
          <li>
            <a
              href={`${entry.base}/`}
              aria-current={isCurrent(entry) ? "true" : undefined}
            >
              {entry.label}
              {entry.latest ? " (latest)" : ""}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .version-switcher {
    padding: 0.5rem 0 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    margin-bottom: 0.5rem;
  }
  .version-switcher__label {
    display: block;
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.25rem;
  }
  .version-switcher__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .version-switcher__list a {
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .version-switcher__list a[aria-current="true"] {
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
