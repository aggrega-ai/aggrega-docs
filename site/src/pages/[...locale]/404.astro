---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getEntry } from "astro:content";
import { publishedLanguages } from "../../translations.mjs";

// The not-found page, one per language: /404.html for English and
// /<language>/404.html for each published language (src/not-found.mjs gives
// each the file name the host answers a missing page with). A missing page
// under a language's path is answered with that language's not-found page,
// which says so in the language and links to the home page of the same
// version in the same language, under that page's title.
export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    ...publishedLanguages.map(({ locale }) => ({ params: { locale } })),
  ];
}

const { locale } = Astro.params;
const home = (await getEntry("docs", locale ?? "index")) ?? (await getEntry("docs", "index"));
const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${locale ? `${locale}/` : ""}`;
---

<StarlightPage
  frontmatter={{
    title: "404",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: {
      tagline: Astro.locals.t("404.text"),
      actions: [
        {
          text: String(home?.data.title ?? "Aggrega"),
          link: homeHref,
          icon: "right-arrow",
          variant: "primary",
        },
      ],
    },
  }}
/>
