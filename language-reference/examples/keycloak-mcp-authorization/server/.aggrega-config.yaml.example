# Copy this file to server/.aggrega-config.yaml and adjust it to your machine.
# That copy is ignored by git. It is read in addition to the workspace's own
# .aggrega-config.yaml whenever `aggrega mcp` is started from this directory,
# so the listener's settings stay out of the committed configuration while the
# server still serves this workspace.

mcp:
  # Where the server listens. A certificate for this address is required,
  # because the listener is reached over HTTPS.
  listen: 127.0.0.1:8443
  tls:
    # A certificate and key for the host name clients use. Write these as
    # absolute paths when the files live outside this directory; a relative
    # path is read from this directory.
    cert_file: /path/to/server.crt
    key_file: /path/to/server.key
  authorization:
    # Exactly the issuer Keycloak states for the realm — the "issuer" field of
    # http://localhost:8080/realms/aggrega/.well-known/openid-configuration.
    issuer: http://localhost:8080/realms/aggrega
    # The address clients reach this server at. It is the audience every token
    # must name, so pass the same value to realm/apply-realm.sh --resource.
    resource: https://localhost:8443/mcp
    # Leave unset to read the keys from the issuer. Set it to a file holding
    # the realm's key set to verify tokens without contacting Keycloak.
    # jwks_file: /path/to/aggrega-realm.jwks.json
  health:
    # Liveness and readiness, answered here and not on the listener above.
    listen: 127.0.0.1:8444
