{
  "realm": {
    "realm": "aggrega",
    "displayName": "Aggrega",
    "enabled": true,
    "sslRequired": "external",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true
  },
  "clientScopes": [
    {
      "name": "aggrega:read",
      "description": "Read what the Aggrega server's workspace holds: list, describe, validate, lint, and build in memory.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your Aggrega workspace"
      },
      "protocolMappers": [
        {
          "name": "aggrega-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "__AGGREGA_RESOURCE__",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aggrega:workspace-write",
      "description": "Write inside the Aggrega server's workspace: resolve a Release's dependencies and write its lockfile, pin, edit and import documents.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Change files in your Aggrega workspace"
      },
      "protocolMappers": [
        {
          "name": "aggrega-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "__AGGREGA_RESOURCE__",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aggrega:registry-write",
      "description": "Publish, sign and withdraw artifacts in a registry on the Aggrega server's behalf.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Publish, sign and withdraw Aggrega artifacts in a registry"
      },
      "protocolMappers": [
        {
          "name": "aggrega-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "__AGGREGA_RESOURCE__",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultClientScopes": [],
  "optionalClientScopes": [
    "aggrega:read",
    "aggrega:workspace-write",
    "aggrega:registry-write"
  ],
  "anonymousClientRegistration": {
    "trustedHosts": [
      "localhost",
      "127.0.0.1"
    ],
    "allowedClientScopes": [
      "aggrega:read",
      "aggrega:workspace-write",
      "aggrega:registry-write"
    ]
  }
}
